<UserControl x:Class="PrismCrosshair.Views.CrosshairsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrismCrosshair.Controls"
             xmlns:models="clr-namespace:PrismCrosshair.Models">

    <UserControl.Resources>
        <DrawingBrush x:Key="GridPattern" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L28,0 M0,0 L0,28">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0EFFFFFF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="HeroNameBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentSecondary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSolid}"/>
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Click to rename"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditBg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditBg" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditBg" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
        <StackPanel Margin="28,18,28,26">

            <!-- HERO -->
            <Border Height="326" CornerRadius="20" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="12" Opacity="0.26" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="366"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- hero info -->
                    <Border Grid.Column="0" CornerRadius="20,0,0,20" Padding="28,24,24,22"
                            Background="{DynamicResource HeroBackgroundBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource AccentPill}" HorizontalAlignment="Left" Padding="9,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE CROSSHAIR" FontSize="8.5" FontWeight="Bold" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <TextBox Style="{StaticResource HeroNameBox}" Margin="0,11,0,0"
                                         Text="{Binding Current.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                                    <TextBlock Text="{Binding Current.StyleLabel}" FontSize="11.5" Foreground="{StaticResource TextSoftBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextDimBrush}" Margin="9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Current.Size, StringFormat={}{0:0} px}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextDimBrush}" Margin="9,0" VerticalAlignment="Center"/>
                                    <Border Width="30" Height="9" CornerRadius="5" VerticalAlignment="Center">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource GradientBrush}">
                                                <Binding Path="Current.Color1"/>
                                                <Binding Path="Current.Color2"/>
                                                <Binding Path="Current.GradientAngle"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="A live in-game overlay. Tune shape, thickness, gradient and glow — all in real time."
                                       Style="{StaticResource MutedText}" Margin="1,16,0,0" MaxWidth="292" LineHeight="18"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Click="Edit_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoWand}" Style="{StaticResource ButtonIcon}" Width="15" Height="15"/>
                                        <TextBlock Text="Open editor" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="SaveAs_Click"
                                        ToolTip="Save the current settings as a separate profile">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoSave}" Style="{StaticResource SmallButtonIcon}"/>
                                        <TextBlock Text="Save as" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Row="3" Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12"
                                    Padding="11,9" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentTint}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoEye}" Style="{StaticResource DecorativeIcon}" Width="14" Height="14"
                                              Stroke="{DynamicResource AccentText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Overlay is on" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="F8 — hide or show" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" Grid.Column="2" IsChecked="{Binding Current.Visible, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- preview -->
                    <Grid Grid.Column="1" ClipToBounds="True">
                        <controls:ArenaBackdrop Mode="Training" CornerRadius="19"
                                                Accent1="{Binding Current.Color1}" Accent2="{Binding Current.Color2}"/>
                        <controls:CrosshairView Settings="{Binding Current}" RenderScale="5.6" Animate="True"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Left" Width="84" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#CC0C111C" Offset="0"/>
                                    <GradientStop Color="#000C111C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border Style="{StaticResource Pill}" Background="#B80A0A0C" BorderBrush="{DynamicResource StrokeBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE PREVIEW" FontSize="8.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#A60A0A0C" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18" Padding="9,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="3" Background="{Binding Current.Color1, Converter={StaticResource HexToBrush}}"/>
                                <Border Width="9" Height="9" CornerRadius="3" Margin="3,0,0,0" Background="{Binding Current.Color2, Converter={StaticResource HexToBrush}}"
                                        Visibility="{Binding Current.UseGradient, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Current.Color1}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{StaticResource TextSoftBrush}" Margin="8,0,0,0"/>
                                <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextDimBrush}" Margin="4,0"
                                           Visibility="{Binding Current.UseGradient, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Current.Color2}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{StaticResource TextSoftBrush}"
                                           Visibility="{Binding Current.UseGradient, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#A60A0A0C" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Padding="9,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoCrosshair}" Style="{StaticResource DecorativeIcon}" Width="11" Height="11"
                                      Stroke="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="1:1 · PIXEL PERFECT" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- LIBRARY HEADER -->
            <Grid Margin="2,25,2,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Library" Style="{StaticResource SectionTitle}" FontSize="17"/>
                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="12" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <TextBlock Text="Community presets and your saved setups" Style="{StaticResource MutedText}" Margin="12,1,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="All" GroupName="PresetFilter" Tag="all" IsChecked="True" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked"/>
                    <RadioButton Content="Basic" GroupName="PresetFilter" Tag="Basic" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked" Margin="4,0,0,0"/>
                    <RadioButton Content="Tactical" GroupName="PresetFilter" Tag="Tactical" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked" Margin="4,0,0,0"/>
                    <RadioButton Content="Minimal" GroupName="PresetFilter" Tag="Minimal" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked" Margin="4,0,0,0"/>
                    <RadioButton Content="Signature" GroupName="PresetFilter" Tag="Signature" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked" Margin="4,0,0,0"/>
                    <RadioButton Content="Mine" GroupName="PresetFilter" Tag="Mine" Style="{StaticResource ChipRadio}"
                                 Checked="Filter_Checked" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="12,0,0,0" Padding="11,0" Click="Create_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoPlus}" Style="{StaticResource SmallButtonIcon}"/>
                            <TextBlock Text="Create" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- PRESETS -->
            <ItemsControl x:Name="PresetItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CrosshairPreset}">
                        <Button Style="{StaticResource PresetCardButton}" Width="218" Height="170" Margin="0,0,14,14"
                                Click="Preset_Click" Tag="{Binding}">
                            <Border x:Name="CardBg" BorderThickness="1" CornerRadius="15">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="#1C2638"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="110"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Border Background="{DynamicResource SurfaceDeepBrush}" CornerRadius="14,14,0,0"/>
                                        <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Margin="0,0,-40,-28" IsHitTestVisible="False"
                                                 Fill="{Binding Accent, Converter={StaticResource AccentPreviewBrush}}"/>
                                        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.7" IsHitTestVisible="False"/>
                                        <controls:CrosshairView Settings="{Binding Settings}" RenderScale="3.0" Animate="False"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Background="#B8080D16" BorderBrush="{DynamicResource StrokeBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0" Padding="7,3">
                                            <TextBlock Text="{Binding Badge}" FontSize="7.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"
                                                Width="20" Height="20" CornerRadius="7" Background="{DynamicResource AccentGradient}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource IcoCheck}" Stroke="#07110D" StrokeThickness="2.2"
                                                  Width="10" Height="10" Stretch="Uniform" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Path Data="{StaticResource IcoClose}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6"
                                              Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Margin="0,0,10,9" Cursor="Hand" ToolTip="Delete my crosshair"
                                              Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                                              MouseLeftButtonUp="DeletePreset_Click" Tag="{Binding}"/>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="12,10,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Settings.StyleLabel}" Style="{StaticResource PresetInfo}"/>
                                                <TextBlock Text="·" Style="{StaticResource PresetInfo}" Margin="5,0"/>
                                                <TextBlock Text="{Binding Settings.Size, StringFormat={}{0:0} px}" Style="{StaticResource PresetInfo}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Surface2Brush}"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IcoChevronRight}" Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.6" Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource RowCard}" Margin="0,4,0,0" Padding="14,11" Background="#0A0E17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IcoSpark}" Style="{StaticResource DecorativeIcon}" Stroke="{DynamicResource AccentText}"
                          Width="15" Height="15" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tip: save a setup you like with the Save button — it will appear under Mine."
                               Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5"/>
                    <TextBlock Grid.Column="2" Text="Save button" FontFamily="{StaticResource MonoFont}" FontSize="9"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

