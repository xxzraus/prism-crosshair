<UserControl x:Class="PrismCrosshair.Views.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PrismCrosshair.Models">

    <UserControl.Resources>
        <Style x:Key="ActionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="ActionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,3,16,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,28">

            <!-- HERO -->
            <Border Height="156" CornerRadius="18" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,16"
                Background="{DynamicResource HeroBackgroundBrush}">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="54" Height="54" CornerRadius="15" Background="{DynamicResource AccentGradient}" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.35" Color="#8A919B"/>
                        </Border.Effect>
                        <Path Data="{StaticResource IcoKeyboard}" Stroke="#07110D" StrokeThickness="1.7" Width="26" Height="26"
                              Stretch="Uniform" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource AccentPill}" HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,8">
                            <TextBlock Text="GLOBAL HOTKEYS" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                       Foreground="{DynamicResource AccentText}"/>
                        </Border>
                        <TextBlock Text="Control it without leaving the game" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Hotkeys work even when PRISM is minimized and the game is fullscreen."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Global hotkeys" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                            <TextBlock FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="disabled"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hotkeys.Enabled}" Value="True">
                                                <Setter Property="Text" Value="enabled"/>
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Hotkeys.Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ACTIONS -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" FontSize="15"/>
                                <TextBlock Text="Assign keys for quick control" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Right" Padding="8,0" Click="ResetHotkeys_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoRotate}" Style="{StaticResource SmallButtonIcon}"/>
                                    <TextBlock Text="Reset" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,15"/>

                        <!-- toggle overlay -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcoEye}" Style="{StaticResource DecorativeIcon}" Width="15" Height="15"
                                      Stroke="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show / hide overlay" Style="{StaticResource ActionTitle}"/>
                                <TextBlock Text="Instantly hides the crosshair and brings it back" Style="{StaticResource ActionSubtitle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Style="{StaticResource PrismComboBox}" VerticalAlignment="Center"
                                      ItemsSource="{x:Static models:HotkeyOptions.All}"
                                      SelectedItem="{Binding Hotkeys.ToggleOverlay, Mode=TwoWay}"/>
                            <Border Grid.Column="3" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#0A1A15" BorderBrush="#1C3B30">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" FontSize="8.5" Foreground="{StaticResource GreenBrush}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14"/>

                        <!-- next preset -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcoCrosshair}" Style="{StaticResource DecorativeIcon}" Width="15" Height="15"
                                      Stroke="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Next crosshair" Style="{StaticResource ActionTitle}"/>
                                <TextBlock Text="Cycles through presets without opening the window" Style="{StaticResource ActionSubtitle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Style="{StaticResource PrismComboBox}" VerticalAlignment="Center"
                                      ItemsSource="{x:Static models:HotkeyOptions.All}"
                                      SelectedItem="{Binding Hotkeys.NextProfile, Mode=TwoWay}"/>
                            <Border Grid.Column="3" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#0A1A15" BorderBrush="#1C3B30">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" FontSize="8.5" Foreground="{StaticResource GreenBrush}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14"/>

                        <!-- editor -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcoSliders}" Style="{StaticResource DecorativeIcon}" Width="15" Height="15"
                                      Stroke="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open editor" Style="{StaticResource ActionTitle}"/>
                                <TextBlock Text="Restores PRISM and opens shape settings" Style="{StaticResource ActionSubtitle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Style="{StaticResource PrismComboBox}" VerticalAlignment="Center"
                                      ItemsSource="{x:Static models:HotkeyOptions.All}"
                                      SelectedItem="{Binding Hotkeys.OpenEditor, Mode=TwoWay}"/>
                            <Border Grid.Column="3" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#0A1A15" BorderBrush="#1C3B30">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" FontSize="8.5" Foreground="{StaticResource GreenBrush}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14"/>

                        <!-- panic -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="#2A1419" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcoEye}" Style="{StaticResource DecorativeIcon}" Width="15" Height="15"
                                      Stroke="{StaticResource RedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Panic hide" Style="{StaticResource ActionTitle}"/>
                                <TextBlock Text="Hides the overlay and PRISM in the tray with one key" Style="{StaticResource ActionSubtitle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Style="{StaticResource PrismComboBox}" VerticalAlignment="Center"
                                      ItemsSource="{x:Static models:HotkeyOptions.All}"
                                      SelectedItem="{Binding Hotkeys.PanicHide, Mode=TwoWay}"/>
                            <Border Grid.Column="3" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#1C1217" BorderBrush="#3A2028">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Panic" FontSize="8.5" Foreground="{StaticResource YellowBrush}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IcoHelp}" Style="{StaticResource DecorativeIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="If a key is already used by another app, PRISM will let you know and ask you to choose another."
                                           Style="{StaticResource MutedText}" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SIDE -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Key map" Style="{StaticResource SectionTitle}" FontSize="14"/>
                            <TextBlock Text="Assigned keys are highlighted" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>

                            <ItemsControl x:Name="KeyMapItems" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KeyBg" Height="34" Margin="3" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                                            <TextBlock x:Name="KeyText" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                <Setter TargetName="KeyBg" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                                <Setter TargetName="KeyBg" Property="BorderBrush" Value="Transparent"/>
                                                <Setter TargetName="KeyBg" Property="ToolTip" Value="{Binding Action}"/>
                                                <Setter TargetName="KeyText" Property="Foreground" Value="#07110D"/>
                                                <Setter TargetName="KeyText" Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="KeyMapSummary" Text="4 of 12 assigned" Style="{StaticResource MicroLabel}" Margin="3,8,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,16"/>

                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource AccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Works globally" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Keys are captured by the system, not by the game window." Style="{StaticResource MutedText}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource AccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Fewer conflicts" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Use F-keys: they are rarely taken in games." Style="{StaticResource MutedText}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource AccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Always within reach" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Even when PRISM is minimized to the system tray." Style="{StaticResource MutedText}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IcoShield}" Width="17" Height="17" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Text="No injection" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Hotkeys are registered with Windows. PRISM does not install hooks into the game process."
                                           Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

