<UserControl x:Class="PrismCrosshair.Views.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrismCrosshair.Controls">

    <UserControl.Resources>
        <DrawingBrush x:Key="ScreenGrid" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L26,0 M0,0 L0,26">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#10FFFFFF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="BehaviorTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="BehaviorSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,20,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,28">

            <!-- STATUS BANNER -->
            <Border Height="98" CornerRadius="18" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,16"
                Background="{DynamicResource HeroBackgroundBrush}">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentGradient}" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.32" Color="#8A919B"/>
                        </Border.Effect>
                        <Path Data="{StaticResource IcoEye}" Stroke="#07110D" StrokeThickness="1.8" Width="22" Height="22"
                              Stretch="Uniform" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.VisibilityLabel}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" MaxWidth="620" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="The crosshair is pinned above the game and does not capture the mouse"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStudioActive}" Value="True">
                                            <Setter Property="Text" Value="While the studio is open, the crosshair is hidden. Minimize the window — it will appear above the game."/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current.Visible}" Value="False">
                                            <Setter Property="Text" Value="Hidden by hotkey. Press F8 to bring it back."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" Margin="3,0">
                            <TextBlock Text="TOPMOST" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" Margin="3,0">
                            <TextBlock Text="CLICK-THROUGH" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" Margin="3,0">
                            <TextBlock Text="1:1 PX" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Keycap}" Margin="0,0,12,0">
                            <TextBlock Text="F8" Style="{StaticResource TinyMono}" Foreground="{StaticResource TextSoftBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Current.Visible, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">
                    <!-- POSITION -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Screen position" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <TextBlock Text="The crosshair is centered on the selected display" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Height="28" Padding="8,0"
                                        Click="ResetPosition_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoRotate}" Style="{StaticResource SmallButtonIcon}"/>
                                        <TextBlock Text="Center" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="13" Margin="0,14,0,0" Padding="12">
                                <Viewbox Height="206" Stretch="Uniform">
                                    <Grid Width="590" Height="238">
                                        <Border Margin="8,0,8,22" Background="#0C0C0E" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12"/>
                                        <Border Margin="22,14,22,50" Background="#08080A" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="8">
                                            <Grid ClipToBounds="True">
                                                <Rectangle Fill="{StaticResource ScreenGrid}" Opacity="0.8"/>
                                                <Border Margin="18,14" BorderBrush="#24262B" BorderThickness="1" CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock Text="GAME WINDOW" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                                                   Foreground="#5D6068" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                   Margin="8,6,0,0"/>
                                                        <Border Width="170" Height="92" Background="#08FFFFFF" BorderBrush="#2B2D31"
                                                                BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Rectangle Width="1" Height="150" Fill="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Rectangle Height="1" Width="260" Fill="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <Grid Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Grid.RenderTransform>
                                                                <TranslateTransform
                                                                    X="{Binding Current.OffsetX, Converter={StaticResource Multiply}, ConverterParameter=0.055}"
                                                                    Y="{Binding Current.OffsetY, Converter={StaticResource Multiply}, ConverterParameter=0.05}"/>
                                                            </Grid.RenderTransform>
                                                            <Ellipse Width="26" Height="26" Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" StrokeDashArray="2,3"/>
                                                            <controls:MiniCrosshairView Width="20" Height="20" ReticleStyle="{Binding Current.Style}"
                                                                                        Accent1="{Binding Current.Color1}" Accent2="{Binding Current.Color2}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="DISPLAY 01  ·  1920 × 1080  ·  100%" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                                           Foreground="#6A6D75" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,9"/>
                                                <TextBlock Text="PRISM OVERLAY" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                                           Foreground="#5D6068" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,9"/>
                                            </Grid>
                                        </Border>
                                        <Border Width="120" Height="8" CornerRadius="0,0,4,4" Background="#202125" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                                HorizontalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="POSITION X" Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                                    <Border Style="{StaticResource InputShell}" Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="X:-1" Click="Nudge_Click" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IcoMinus}" Style="{StaticResource SmallButtonIcon}"/>
                                            </Button>
                                            <TextBox Grid.Column="1" Style="{StaticResource HexTextBox}" TextAlignment="Center"
                                                     Text="{Binding Current.OffsetX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                                     KeyDown="NumberBox_KeyDown" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Tag="X:1" Click="Nudge_Click" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IcoPlus}" Style="{StaticResource SmallButtonIcon}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="POSITION Y" Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                                    <Border Style="{StaticResource InputShell}" Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="Y:-1" Click="Nudge_Click" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IcoMinus}" Style="{StaticResource SmallButtonIcon}"/>
                                            </Button>
                                            <TextBox Grid.Column="1" Style="{StaticResource HexTextBox}" TextAlignment="Center"
                                                     Text="{Binding Current.OffsetY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                                     KeyDown="NumberBox_KeyDown" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Tag="Y:1" Click="Nudge_Click" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IcoPlus}" Style="{StaticResource SmallButtonIcon}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="11,0" Tag="-40,0" Click="QuickPosition_Click" ToolTip="Move left">
                                        <Path Data="M15 12H3 M8 7l-5 5 5 5" Style="{StaticResource SmallButtonIcon}" Width="13" Height="13"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="11,0" Margin="5,0,0,0" Tag="0,-40" Click="QuickPosition_Click" ToolTip="Move up">
                                        <Path Data="M12 15V3 M7 8l5-5 5 5" Style="{StaticResource SmallButtonIcon}" Width="13" Height="13"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="11,0" Margin="5,0,0,0" Tag="40,0" Click="QuickPosition_Click" ToolTip="Move right">
                                        <Path Data="M3 12h12 M10 7l5 5-5 5" Style="{StaticResource SmallButtonIcon}" Width="13" Height="13"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="11,0" Margin="5,0,0,0" Tag="0,40" Click="QuickPosition_Click" ToolTip="Move down">
                                        <Path Data="M12 3v12 M7 10l5 5 5-5" Style="{StaticResource SmallButtonIcon}" Width="13" Height="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Offsets are measured in pixels from the center. F8 hides and restores the crosshair."
                                       Style="{StaticResource MutedText}" FontSize="9.5" Margin="2,10,0,0"/>
                            <TextBlock Text="For exclusive fullscreen, use borderless windowed mode — the overlay will stay on top."
                                       FontSize="9" Foreground="{StaticResource YellowBrush}" Margin="2,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- BEHAVIOR -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" FontSize="14"/>
                            <TextBlock Text="How the overlay interacts with the system" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Always on top" Style="{StaticResource BehaviorTitle}"/>
                                    <TextBlock Text="Stays visible even in fullscreen games" Style="{StaticResource BehaviorSubtitle}"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Current.AlwaysOnTop, Mode=TwoWay}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,11"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Click-through" Style="{StaticResource BehaviorTitle}"/>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BehaviorSubtitle}">
                                                <Setter Property="Text" Value="Mouse and keyboard control the game, not the crosshair"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Current.ClickThrough}" Value="False">
                                                        <Setter Property="Text" Value="The overlay captures clicks; F8 — hide or restore"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Current.ClickThrough, Mode=TwoWay}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,11"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource BehaviorTitle}"/>
                                    <TextBlock Text="Silent tray start, crosshair already on screen" Style="{StaticResource BehaviorSubtitle}"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding Preferences.RunAtStartup, Mode=TwoWay}"
                                              Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,11"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Eco mode" Style="{StaticResource BehaviorTitle}"/>
                                    <TextBlock Text="Disables crosshair animation and extra redraws" Style="{StaticResource BehaviorSubtitle}"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Preferences.EcoMode, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">
                    <!-- APPEARANCE -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <TextBlock Text="Overlay scale and opacity" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Height="30" Padding="10,0"
                                        Click="OpenEditor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoWand}" Style="{StaticResource SmallButtonIcon}"/>
                                        <TextBlock Text="Shape" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Height="148" Margin="0,14,0,0">
                                <Grid ClipToBounds="True">
                                    <Rectangle Fill="{StaticResource ScreenGrid}" Opacity="0.65"/>
                                    <Ellipse Width="240" Height="240" Fill="{Binding Current.Color1, Converter={StaticResource AccentPreviewBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <controls:CrosshairView Settings="{Binding Current}" RenderScale="3.4" Animate="False"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Pill}" Background="#B80A0A0C" BorderBrush="{DynamicResource StrokeBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0">
                                        <TextBlock Text="{Binding Current.StyleLabel}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Scale" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Current.Scale, StringFormat={}{0:0.00}×}" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider Style="{StaticResource ModernSlider}" Minimum="0.4" Maximum="3" Value="{Binding Current.Scale, Mode=TwoWay}" Margin="0,2,0,0"/>

                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Current.Opacity, StringFormat={}{0:P0}}" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider Style="{StaticResource ModernSlider}" Minimum="0.05" Maximum="1" Value="{Binding Current.Opacity, Mode=TwoWay}" Margin="0,2,0,0"/>

                            <Border Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,13,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentTint}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoCursor}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="1:1 with physical pixels — size is independent of Windows DPI."
                                               Style="{StaticResource MutedText}" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PERFORMANCE -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Performance" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}"/>
                                    <TextBlock Text="LIVE" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="{StaticResource GreenBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Style="{StaticResource MicroLabel}"/>
                                    <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource MonoFont}" FontSize="17"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CPU" Style="{StaticResource MicroLabel}"/>
                                    <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource MonoFont}" FontSize="17"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RENDERER" Style="{StaticResource MicroLabel}"/>
                                    <TextBlock Text="WPF" FontFamily="{StaticResource MonoFont}" FontSize="17"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="4" CornerRadius="2" Background="#1A1B1E" Margin="0,13,0,0">
                                <Border Width="140" Height="4" CornerRadius="2" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Text="No browser engine or background processes. Static rendering keeps the GPU idle."
                                       Style="{StaticResource MutedText}" FontSize="9" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SAFETY -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IcoShield}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="No interference with the game" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="PRISM is a separate transparent window. It does not read game memory, inject into processes or modify game files."
                                           Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,4,0,0"/>
                                <TextBlock Text="Check the anti-cheat and game rules before use."
                                           FontSize="9" Foreground="{StaticResource YellowBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

