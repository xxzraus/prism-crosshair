<UserControl x:Class="PrismCrosshair.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FeatureTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="FeatureText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,28" MaxWidth="1120" HorizontalAlignment="Center">

            <!-- HERO -->
            <Border Height="284" CornerRadius="20" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    ClipToBounds="True" Background="{DynamicResource HeroBackgroundBrush}">
                <Grid>
                    <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2E8A919B" Offset="0"/>
                                <GradientStop Color="#008A919B" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,240,-120"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#168A919B" Offset="0"/>
                                <GradientStop Color="#008A919B" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource AccentGradient}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.38" Color="#8A919B"/>
                                    </Border.Effect>
                                    <Path Data="{StaticResource IcoCrosshair}" Stroke="#07110D" StrokeThickness="1.8" Width="27" Height="27"
                                          Stretch="Uniform" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PRISM" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextBrush}" LineHeight="40"/>
                                    <TextBlock Text="CROSSHAIR STUDIO" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="A crosshair that stays out of your way." FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,22,0,0"/>
                            <TextBlock Text="A lightweight Windows overlay with deep control over shape, color, glow and behavior. No browser engine, no game injection, no unnecessary noise."
                                       Style="{StaticResource MutedText}" FontSize="11" MaxWidth="560" Margin="0,7,0,0" LineHeight="17"/>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Height="36" Click="Editor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoWand}" Style="{StaticResource SmallButtonIcon}" Width="14" Height="14"/>
                                        <TextBlock Text="Open editor" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Click="Settings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoGear}" Style="{StaticResource SmallButtonIcon}"/>
                                        <TextBlock Text="Settings" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,10,0">
                            <Border Background="#8018181B" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Width="230">
                                <StackPanel>
                                    <TextBlock Text="VERSION" Style="{StaticResource MicroLabel}"/>
                                    <TextBlock Text="1.1.0" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                                    <Border Style="{StaticResource Divider}" Margin="0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Build" Style="{StaticResource MutedText}" FontSize="9"/>
                                        <TextBlock Grid.Column="1" Text="stable" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource GreenBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Platform" Style="{StaticResource MutedText}" FontSize="9"/>
                                        <TextBlock Grid.Column="1" Text="Windows x64" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource TextSoftBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Technology" Style="{StaticResource MutedText}" FontSize="9"/>
                                        <TextBlock Grid.Column="1" Text=".NET 9 · WPF" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource TextSoftBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- FEATURES -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IcoCrosshair}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Precision geometry" Style="{StaticResource FeatureTitle}"/>
                            <TextBlock Text="Pixel-perfect rendering with DPI awareness. The crosshair stays sharp on any monitor."
                                       Style="{StaticResource FeatureText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IcoSliders}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Deep editor" Style="{StaticResource FeatureTitle}"/>
                            <TextBlock Text="8 shapes, two-color gradients, outline, glow, rotation and real-time animation."
                                       Style="{StaticResource FeatureText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IcoCpu}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Low overhead" Style="{StaticResource FeatureTitle}"/>
                            <TextBlock Text="Native WPF instead of Electron and WebView. One process, static rendering at idle."
                                       Style="{StaticResource FeatureText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IcoShield}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" Fill="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Safe overlay" Style="{StaticResource FeatureTitle}"/>
                            <TextBlock Text="Does not read game memory, inject into processes or modify game files. Just a transparent window."
                                       Style="{StaticResource FeatureText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TECH + NOTICE -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Technology stack" Style="{StaticResource SectionTitle}" FontSize="14"/>
                        <WrapPanel Margin="0,11,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="WPF" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text=".NET 9" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="Win32" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="DirectX" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="RegisterHotKey" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="JSON" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource TextSoftBrush}"/></Border>
                        </WrapPanel>
                        <TextBlock Text="Settings are stored locally in your Windows profile. The app does not send data over the network."
                                   Style="{StaticResource MutedText}" FontSize="9" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoShield}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{StaticResource YellowBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                            <TextBlock Text="Important" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Overlays may be prohibited by game or anti-cheat rules. Use PRISM where allowed and check the rules before launching."
                                   Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Made for Windows 10/11 · PRISM Crosshair Studio · 2026" Style="{StaticResource MicroLabel}"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

