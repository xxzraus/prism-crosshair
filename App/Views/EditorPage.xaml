<UserControl x:Class="PrismCrosshair.Views.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrismCrosshair.Controls">

    <UserControl.Resources>
        <Style x:Key="InspectorSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SwitchTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SwitchSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StyleTile" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTint}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,12,28,26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="356"/>
        </Grid.ColumnDefinitions>

        <!-- ================= WORKSPACE ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIVE CANVAS" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Training" GroupName="Backdrop" Tag="Training" IsChecked="True"
                                         Style="{StaticResource SegmentRadio}" Checked="Backdrop_Checked"/>
                            <RadioButton Content="Dark" GroupName="Backdrop" Tag="Dark" Style="{StaticResource SegmentRadio}"
                                         Checked="Backdrop_Checked"/>
                            <RadioButton Content="Light" GroupName="Backdrop" Tag="Light" Style="{StaticResource SegmentRadio}"
                                         Checked="Backdrop_Checked"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="GridToggle" IsChecked="True" Style="{StaticResource ChipToggle}" Margin="10,0,0,0"
                                  Checked="Grid_Changed" Unchecked="Grid_Changed" ToolTip="Show the canvas grid">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoGrid}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.4" Fill="Transparent" VerticalAlignment="Center"/>
                            <TextBlock Text="Grid" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="ZOOM" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ZoomBox" Width="86" SelectedIndex="1" SelectionChanged="Zoom_Changed"
                              Style="{StaticResource PrismComboBox}">
                        <ComboBoxItem Content="3×" Tag="3.2"/>
                        <ComboBoxItem Content="5×" Tag="5.6"/>
                        <ComboBoxItem Content="7×" Tag="7.4"/>
                        <ComboBoxItem Content="9×" Tag="9.2"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" CornerRadius="18" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Background="{DynamicResource SurfaceDeepBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.24" Color="#000000"/>
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <controls:ArenaBackdrop x:Name="Backdrop" Mode="Training" CornerRadius="17"
                                            Accent1="{Binding Current.Color1}" Accent2="{Binding Current.Color2}"/>
                    <controls:CrosshairView x:Name="Preview" Settings="{Binding Current}" RenderScale="5.6" Animate="True"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <Border Background="#A60A0A0C" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                            <TextBlock Text="{Binding ElementName=Preview, Path=RenderScale, StringFormat={}{0:0.0}×}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border VerticalAlignment="Bottom" Height="100" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00080C14" Offset="0"/>
                                <GradientStop Color="#D9080C14" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid VerticalAlignment="Bottom" Margin="18,0,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}" Background="#A60A0A0C" BorderBrush="{DynamicResource StrokeBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Current.StyleLabel}" FontSize="9.5" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Current.Size, StringFormat={}{0:0} px}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Current.Thickness, StringFormat={}{0:0.0} px}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Current.Color1, Converter={StaticResource HexToBrush}}"/>
                            <Border Width="10" Height="10" CornerRadius="3" Margin="3,0,0,0" Background="{Binding Current.Color2, Converter={StaticResource HexToBrush}}"/>
                            <Button Style="{StaticResource GhostButton}" Height="28" Margin="12,0,0,0" Padding="8,0" Click="Reset_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoRotate}" Style="{StaticResource SmallButtonIcon}"/>
                                    <TextBlock Text="Reset" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= INSPECTOR ================= -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IcoSliders}" Style="{StaticResource DecorativeIcon}" Stroke="{DynamicResource AccentText}"
                                  Width="15" Height="15"/>
                            <TextBlock Text="Inspector" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Height="28" Padding="7,0" Click="Reset_Click"
                                ToolTip="Reset the current crosshair">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoRotate}" Style="{StaticResource SmallButtonIcon}"/>
                                <TextBlock Text="Reset" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,14,18">

                        <!-- FORM -->
                        <TextBlock Text="SHAPE" Style="{StaticResource InspectorSection}"/>
                        <ItemsControl x:Name="StyleItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource StyleTile}" Tag="{Binding}" Click="Style_Click" ToolTip="{Binding Name}">
                                        <StackPanel>
                                            <controls:MiniCrosshairView Width="28" Height="28" HorizontalAlignment="Center"
                                                                       ReticleStyle="{Binding Style}"
                                                                       Accent1="{Binding DataContext.Current.Color1, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Accent2="{Binding DataContext.Current.Color2, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.Size, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="2" Maximum="80" Value="{Binding Current.Size, Mode=TwoWay}" Margin="0,2,0,0"/>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.Thickness, StringFormat={}{0:0.0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0.5" Maximum="8" Value="{Binding Current.Thickness, Mode=TwoWay}" Margin="0,2,0,0"/>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Center gap" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.Gap, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="30" Value="{Binding Current.Gap, Mode=TwoWay}" Margin="0,2,0,0"/>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Center dot" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.DotSize, StringFormat={}{0:0.0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="10" Value="{Binding Current.DotSize, Mode=TwoWay}" Margin="0,2,0,0"/>

                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Show dot" Style="{StaticResource SwitchTitle}"/>
                                <TextBlock Text="Marker at the exact center" Style="{StaticResource SwitchSubtitle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Current.ShowDot, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,16"/>

                        <!-- COLOR -->
                        <TextBlock Text="COLOR" Style="{StaticResource InspectorSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:ColorField Grid.Column="0" Label="Primary" ColorHex="{Binding Current.Color1, Mode=TwoWay}"/>
                            <controls:ColorField Grid.Column="2" Label="Secondary" ColorHex="{Binding Current.Color2, Mode=TwoWay}"
                                                 IsEnabled="{Binding Current.UseGradient}">
                                <controls:ColorField.Style>
                                    <Style TargetType="controls:ColorField">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.UseGradient}" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:ColorField.Style>
                            </controls:ColorField>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <StackPanel>
                                <TextBlock Text="Second color" Style="{StaticResource SwitchTitle}"/>
                                <TextBlock Text="Blend two colors into a gradient" Style="{StaticResource SwitchSubtitle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Current.UseGradient, Mode=TwoWay}"/>
                        </Grid>

                        <StackPanel x:Name="GradientOptions" Visibility="{Binding Current.UseGradient, Converter={StaticResource BoolToVis}}">
                            <Border Height="8" CornerRadius="4" Margin="0,12,0,0" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource GradientBrush}">
                                        <Binding Path="Current.Color1"/>
                                        <Binding Path="Current.Color2"/>
                                        <Binding Path="Current.GradientAngle"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>

                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="Gradient angle" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Current.GradientAngle, StringFormat={}{0:0}°}" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="360" Value="{Binding Current.GradientAngle, Mode=TwoWay}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,16"/>

                        <!-- CONTOUR & GLOW -->
                        <TextBlock Text="OUTLINE &amp; GLOW" Style="{StaticResource InspectorSection}"/>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Dark outline" Style="{StaticResource SwitchTitle}"/>
                                <TextBlock Text="Readability on any background" Style="{StaticResource SwitchSubtitle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Current.Outline, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Outline width" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.OutlineWidth, StringFormat={}{0:0.0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="4" Value="{Binding Current.OutlineWidth, Mode=TwoWay}" Margin="0,2,0,0"/>
                        <controls:ColorField Label="Outline color" ColorHex="{Binding Current.OutlineColor, Mode=TwoWay}" Margin="0,10,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Glow" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.Glow, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="24" Value="{Binding Current.Glow, Mode=TwoWay}" Margin="0,2,0,0"/>

                        <Border Style="{StaticResource Divider}" Margin="0,16"/>

                        <!-- MOTION -->
                        <TextBlock Text="MOTION" Style="{StaticResource InspectorSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Animation" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AnimationBox" Grid.Column="1" Width="142" Style="{StaticResource PrismComboBox}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Current.Animation, Mode=TwoWay}"
                                      SelectionChanged="Animation_Changed"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Speed" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.AnimationSpeed, StringFormat={}{0:0.0}×}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="0.2" Maximum="3" Value="{Binding Current.AnimationSpeed, Mode=TwoWay}" Margin="0,2,0,0"/>

                        <Grid Margin="0,13,0,0">
                            <StackPanel>
                                <TextBlock Text="Rounded caps" Style="{StaticResource SwitchTitle}"/>
                                <TextBlock Text="Soft arms instead of sharp ones" Style="{StaticResource SwitchSubtitle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Current.RoundedCaps, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Rotation" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Current.Rotation, StringFormat={}{0:0}°}" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Slider Style="{StaticResource ModernSlider}" Minimum="-180" Maximum="180" Value="{Binding Current.Rotation, Mode=TwoWay}" Margin="0,2,0,0"/>

                        <Border Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8" Margin="0,18,0,0">
                            <TextBlock Text="Changes apply instantly and are saved automatically." FontSize="9.5"
                                       Foreground="{DynamicResource AccentText}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

