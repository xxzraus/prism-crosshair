<Window x:Class="PrismCrosshair.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PRISM — Crosshair Studio"
        Width="1500" Height="930" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#070708" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/prism.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" CanExecute="SaveCommand_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Control"/>
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradient}"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.38" Color="#8A919B"/>
                            </Border.Effect>
                            <Path Data="{StaticResource IcoCrosshair}" Stroke="#07110D" StrokeThickness="1.9"
                                  Width="21" Height="21" Stretch="Uniform" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRISM" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="CROSSHAIR STUDIO" FontSize="7.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="1,1,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource AccentPill}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="1.1" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource AccentText}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <StackPanel Margin="12,0">
                            <TextBlock Text="STUDIO" Style="{StaticResource MicroLabel}" Margin="12,5,0,8"/>

                            <RadioButton x:Name="NavCrosshairs" GroupName="Nav" Tag="crosshairs" Style="{StaticResource NavRadio}"
                                         IsChecked="True" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoCrosshair}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Crosshairs" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="7,2" VerticalAlignment="Center"
                                            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}">
                                        <TextBlock Text="{Binding Presets.Count}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavEditor" GroupName="Nav" Tag="editor" Style="{StaticResource NavRadio}" Checked="Nav_Checked" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoSliders}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Editor" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavOverlay" GroupName="Nav" Tag="overlay" Style="{StaticResource NavRadio}" Checked="Nav_Checked" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoLayers}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Overlay" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Current.Visible}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavHotkeys" GroupName="Nav" Tag="hotkeys" Style="{StaticResource NavRadio}" Checked="Nav_Checked" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoKeyboard}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Hotkeys" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" Style="{StaticResource MicroLabel}" Margin="12,22,0,8"/>

                            <RadioButton x:Name="NavSettings" GroupName="Nav" Tag="settings" Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoGear}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavAbout" GroupName="Nav" Tag="about" Style="{StaticResource NavRadio}" Checked="Nav_Checked" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoHelp}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="About" Style="{StaticResource NavLabel}" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <!-- performance card -->
                        <Border Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="#1A2334" BorderThickness="1" CornerRadius="14" Padding="14"
                                Visibility="{Binding Preferences.ShowPerformance, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PERFORMANCE" Style="{StaticResource MicroLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="LIVE" FontFamily="{StaticResource MonoFont}" FontSize="8" Margin="4,0,0,0"
                                                   Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="MEMORY" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource StrokeBrush}" Margin="0,1,0,1"/>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="CPU" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="3" CornerRadius="2" Background="#182133" Margin="0,12,0,0">
                                    <Border Width="96" Height="3" CornerRadius="2" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="Eco mode · static rendering" Style="{StaticResource MicroLabel}"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,10,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Height="32" Padding="8,0" HorizontalAlignment="Left" Click="Help_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoHelp}" Style="{StaticResource SmallButtonIcon}"/>
                                    <TextBlock Text="Help" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" Padding="8,0" Click="Tray_Click"
                                    ToolTip="Minimize to tray">
                                <Path Data="{StaticResource IcoMinus}" Style="{StaticResource SmallButtonIcon}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN AREA ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="28,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="Crosshair library" Style="{StaticResource PageTitle}" FontSize="22"/>
                            <TextBlock x:Name="PageSubtitleText" Text="Ready-made presets and your own setups" Style="{StaticResource PageSubtitle}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                        Visibility="{Binding Preferences.ShowHotkeyHints, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Keycap}" ToolTip="Show or hide the overlay">
                                    <TextBlock Text="F8" Style="{StaticResource TinyMono}" Foreground="{StaticResource TextSoftBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource Keycap}" Margin="6,0,0,0" ToolTip="Next crosshair">
                                    <TextBlock Text="F9" Style="{StaticResource TinyMono}" Foreground="{StaticResource TextSoftBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Click="Save_Click"
                                    ToolTip="Save the current crosshair to the library">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoSave}" Style="{StaticResource SmallButtonIcon}"/>
                                    <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="StatusButton" Style="{StaticResource GhostButton}" Height="34" Margin="10,0,0,0"
                                    Padding="10,0" Click="Status_Click" ToolTip="Show or hide the overlay (F8)">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Current.Visible}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.75" Color="#46E6A8"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Current.VisibilityLabel}" Margin="7,0,0,0" VerticalAlignment="Center"
                                               FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="24" Background="{DynamicResource StrokeBrush}" Margin="12,0,10,0"/>

                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="{StaticResource IcoMinus}" Style="{StaticResource ButtonIcon}" Width="15" Height="15"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize">
                                <Path x:Name="MaxIcon" Data="{StaticResource IcoMaximize}" Style="{StaticResource ButtonIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="Close">
                                <Path Data="{StaticResource IcoClose}" Style="{StaticResource ButtonIcon}" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl x:Name="PageHost" Focusable="False"/>

                    <!-- Toast -->
                    <Border x:Name="ToastPanel" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="0,0,0,24" Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,9"
                            Panel.ZIndex="50">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.4" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentGradient}">
                                <Path Data="{StaticResource IcoCheck}" Stroke="#07110D" StrokeThickness="2" Width="12" Height="12"
                                      Stretch="Uniform" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="ToastText" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- soft ambient light, no interaction -->
            <Ellipse Grid.Column="1" Width="540" Height="540" HorizontalAlignment="Right" VerticalAlignment="Top"
                     IsHitTestVisible="False" Margin="0,-300,-220,0" Opacity="0.32">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2E8A919B" Offset="0"/>
                        <GradientStop Color="#008A919B" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Border>
</Window>
