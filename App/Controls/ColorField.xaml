<UserControl x:Class="PrismCrosshair.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FieldLabel}" Margin="2,0,0,7"/>
        <Border x:Name="FieldBorder" Style="{StaticResource InputShell}" Padding="0" Cursor="Hand" MouseLeftButtonUp="OpenPalette">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <Border Margin="6" CornerRadius="7" Background="{Binding ColorHex, ElementName=Root, Converter={StaticResource HexToBrush}}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ColorHex, ElementName=Root, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource HexTextBox}"
                         PreviewMouseLeftButtonDown="HexBox_PreviewMouseLeftButtonDown"
                         KeyDown="HexBox_KeyDown"/>
                <Path Grid.Column="2" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                      HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
        </Border>
        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=FieldBorder}" Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="8">
            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14" Width="342" Margin="0,0,14,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Border Height="5" CornerRadius="3" Margin="0,0,0,11" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF3B5C" Offset="0"/>
                                <GradientStop Color="#FFD36E" Offset="0.2"/>
                                <GradientStop Color="#A7FF6B" Offset="0.4"/>
                                <GradientStop Color="#3EE8C4" Offset="0.58"/>
                                <GradientStop Color="#5AA7FF" Offset="0.76"/>
                                <GradientStop Color="#B06BFF" Offset="0.9"/>
                                <GradientStop Color="#FF4DB8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="2,0,2,9">
                        <TextBlock Text="Palette" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="48 colors" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Palette, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchButton}" Tag="{Binding}" Click="Swatch_Click"
                                        ToolTip="{Binding}" Background="{Binding Converter={StaticResource HexToBrush}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ColorHex, ElementName=Root}" Style="{StaticResource TinyMono}" Foreground="{StaticResource TextSoftBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
